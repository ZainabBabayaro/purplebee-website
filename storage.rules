rules_version = '2';

// Firebase Storage rules — fallback image host when Cloudflare R2 is not bound.
// Public read (product images are public), admin-only writes.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isAdmin == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
