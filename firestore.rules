rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Inventory (store products) ──────────────────────────────────────────
    // Public read so the store loads without login.
    // Only admins can write.
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    // Customers can create and read their own orders.
    // Admins can read and update any order.
    // Nobody deletes — cancel via status field.
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Blog posts ──────────────────────────────────────────────────────────
    // Anyone can read published posts (public blog).
    // Only admins can create, update or delete.
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Admins collection ───────────────────────────────────────────────────
    // Completely unreadable from the client — prevents enumeration.
    // Only set via Firebase Console or server-side code.
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
