rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Inventory ───────────────────────────────────────────────────────────
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Anyone (signed in or guest) can create an order.
      allow create: if request.resource.data.status == 'pending_payment';

      // Allow updating status to 'confirmed' only — this is the post-payment
      // client-side fallback in case the webhook hasn't fired yet.
      allow update: if isAdmin()
        || (resource.data.status == 'pending_payment'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if false;
    }

    // ── Blog posts ───────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Comments ─────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if
        request.resource.data.approved == false
        && request.resource.data.keys().hasAll(['postSlug','name','email','body','createdAt','approved']);
      allow update, delete: if isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
