rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Inventory ───────────────────────────────────────────────────────────
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_payment';
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Blog posts ───────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Comments ─────────────────────────────────────────────────────────────
    // Anyone can read approved comments.
    // Anyone can submit a new comment (lands as approved:false for moderation).
    // Only admins can approve, unapprove, or delete.
    match /comments/{commentId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if
        request.resource.data.approved == false
        && request.resource.data.keys().hasAll(['postSlug','name','email','body','createdAt','approved']);
      allow update, delete: if isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
