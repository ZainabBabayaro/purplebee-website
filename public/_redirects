# Redirect product alias to canonical cake URL
/product/:slug /cakes/:slug 301

# Redirect legacy /shop to canonical store URL
/shop /store 301

# Redirect duplicate /cakes to canonical /our-cakes
/cakes /our-cakes 301

# Redirect duplicate privacy URL to canonical
/privacy-policy /privacy 301

# SPA fallback (must be last)
/*    /index.html    200
